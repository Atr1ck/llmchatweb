{
  "name": "canvas-flow",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "server": "ts-node-dev --project server/tsconfig.json --respawn --transpile-only server/index.ts",
    "server:typecheck": "tsc --noEmit -p server/tsconfig.json",
    "web:dev": "cd web && npm run dev",
    "web:build": "cd web && npm run build",
    "web:typecheck": "cd web && npm run typecheck",
    "web:test": "cd web && npm run test",
    "web:preview": "cd web && npm run preview",
    "dev": "concurrently \"npm run server\" \"npm run web:dev\"",
    "benchmark:canvas": "node scripts/canvas-benchmark.mjs",
    "check": "npm run server:typecheck && npm run web:typecheck && npm run web:test && npm run web:build && npm run benchmark:canvas"
  },
  "dependencies": {
    "concurrently": "^9.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.0"
  }
}
